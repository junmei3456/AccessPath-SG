Cell[BoxData[
 RowBox[{
  RowBox[{"IDtrain", "[", 
   RowBox[{"som_", ",", "vec_", ",", "sel_", ",", "ite_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "weights", ",", "distances", ",", "dim", ",", "somLen", ",", "sig", ",", 
      "inputN", ",", "bmus", ",", "ns", ",", "allNS", ",", "nst", ",", "u", 
      ",", "error"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"weights", " ", "=", " ", 
      RowBox[{"som", "[", "\"\<weights\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"distances", " ", "=", " ", 
      RowBox[{"som", "[", "\"\<distances\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dim", " ", "=", " ", 
      RowBox[{
       RowBox[{"som", "[", "\"\<dimensions\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"somLen", " ", "=", " ", 
      RowBox[{"som", "[", 
       RowBox[{"\"\<dimensions\>\"", ",", "\"\<len\>\""}], "]"}]}], ";", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"u", "=", "0"}], ",", 
       RowBox[{"u", "\[LessEqual]", "ite"}], ",", 
       RowBox[{"u", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sig", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"Nest", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"(", 
                 RowBox[{"u", "/", 
                  RowBox[{"(", 
                   RowBox[{"ite", "+", "1"}], ")"}]}], ")"}]}], ")"}], "*", 
              "#"}], "&"}], ",", 
            RowBox[{
             RowBox[{"Max", "[", "dim", "]"}], "/", "4"}], ",", "1"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"inputN", " ", "=", " ", 
         RowBox[{"RandomChoice", "[", 
          RowBox[{"vec", ",", " ", "sel"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bmus", " ", "=", " ", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Nearest", "[", 
           RowBox[{
            RowBox[{"MapIndexed", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "\[Rule]", 
                RowBox[{"#2", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "&"}], ",", "weights"}], 
             "]"}], ",", "inputN", ",", "1"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ns", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"distances", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], ")"}], "^", "2"}]}], " ", 
             "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", 
               RowBox[{"sig", "^", "2"}]}], ")"}]}], "]"}], "&"}], "/@", " ", 
          "bmus"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"allNS", " ", "=", " ", 
         RowBox[{"Total", "@", "ns"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nst", " ", "=", " ", 
         RowBox[{"Transpose", "@", "ns"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"weights", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"inputN", "*", 
              RowBox[{"nst", "[", 
               RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"allNS", "[", 
             RowBox[{"[", "#", "]"}], "]"}]}], "&"}], "/@", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", "somLen"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"error", "=", 
           RowBox[{"IDerror", "[", 
            RowBox[{"som", ",", "vec"}], "]"}]}], ";"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"error", " ", "=", " ", 
         RowBox[{"Mean", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"EuclideanDistance", "[", 
             RowBox[{
              RowBox[{"inputN", "[", 
               RowBox[{"[", "h", "]"}], "]"}], ",", 
              RowBox[{"weights", "[", 
               RowBox[{"[", 
                RowBox[{"bmus", "[", 
                 RowBox[{"[", "h", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"h", ",", "1", ",", 
              RowBox[{"inputN", "//", "Length"}]}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<iteration \>\"", "<>", 
          RowBox[{"ToString", "@", "u"}], "<>", "\"\<    error=\>\"", "<>", 
          RowBox[{"ToString", "@", "error"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"error", "<", "0.4"}], ",", 
          RowBox[{
           RowBox[{"u", "=", 
            RowBox[{"ite", "+", "1"}]}], ";", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<iteration \>\"", "<>", 
             RowBox[{"ToString", "@", "u"}], "<>", "\"\<    error=\>\"", "<>", 
             RowBox[{"ToString", "@", "error"}]}], "]"}]}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "weights"}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
