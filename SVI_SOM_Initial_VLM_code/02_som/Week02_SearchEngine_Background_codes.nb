Cell[BoxData[
 RowBox[{
  RowBox[{"renderimginbmu", "[", 
   RowBox[{"som_", ",", "bmuindex_", ",", 
    RowBox[{"maxItem_", ":", "4"}], ",", "imgfolder_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"img2show", ",", "bmuimg", ",", 
      RowBox[{"whiteimg", "=", 
       RowBox[{"Image", "@", 
        RowBox[{"Table", "[", 
         RowBox[{"1", ",", "$CellRenderSize", ",", "$CellRenderSize"}], 
         "]"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"img2show", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"som", "[", "\"\<eventListSorted\>\"", "]"}], "[", 
        RowBox[{"[", "bmuindex", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", 
         RowBox[{"UpTo", "@", "maxItem"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"img2show", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"imgfolder", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
       "img2show"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"bmuimg", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "@", "img2show"}], " ", ">", " ", "maxItem"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ImagePad", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#", "\[NotEqual]", "\"\<\>\""}], ",", 
              RowBox[{"ImportCropedImage", "[", "#", "]"}], ",", "whiteimg"}],
              "]"}], ",", "$CellPadSize", ",", "White"}], "]"}], "&"}], "/@", 
         "img2show"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "<=", 
             RowBox[{"Length", "@", "img2show"}]}], ",", 
            RowBox[{"ImportCropedImage", "[", 
             RowBox[{"img2show", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "whiteimg"}], "]"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "maxItem"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bmuimg", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"ImagePad", "[", 
         RowBox[{"#", ",", "$CellPadSize", ",", "White"}], "]"}], "&"}], "/@",
        "bmuimg"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ImageAssemble", "[", 
      RowBox[{"Partition", "[", 
       RowBox[{"bmuimg", ",", 
        RowBox[{"IntegerPart", "@", 
         RowBox[{"N", "@", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Length", "@", "bmuimg"}], "]"}]}]}]}], "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
