   RowBox[{"BMU", "[", 
    RowBox[{"som_", ",", "vector_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Depth", "@", "vector"}], "\[Equal]", "2"}], ",", 
