Cell[BoxData[
 RowBox[{
  RowBox[{"CellSelection", "[", 
   RowBox[{"som_", ",", "cell1_", ",", "radius_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "g", ",", "selectedClusters", ",", "selectedEvents", ",", "sel", ",", 
      "lengthSelected"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"g", "=", 
      RowBox[{"GridGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"som", "[", 
           RowBox[{
           "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<x\>\""}], 
           "]"}], ",", 
          RowBox[{"som", "[", 
           RowBox[{
           "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<y\>\""}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"VertexSize", "\[Rule]", "0.6"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"selectedClusters", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"AdjacencyList", "[", 
         RowBox[{"g", ",", "cell1", ",", "radius"}], "]"}], ",", 
        RowBox[{"{", "cell1", "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"sel", "=", 
      RowBox[{"Rotate", "[", 
       RowBox[{
        RowBox[{"HighlightGraph", "[", 
         RowBox[{"g", ",", "selectedClusters"}], "]"}], ",", 
        RowBox[{"270", "Degree"}]}], "]"}]}], ";", "\n", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<g\>\"", "\[Rule]", "g"}], ";", "\n", 
        RowBox[{"\"\<selectedClusters\>\"", "->", "selectedClusters"}]}], ",",
        "\n", 
       RowBox[{"\"\<selectedGraph\>\"", "\[Rule]", "sel"}]}], 
      "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
