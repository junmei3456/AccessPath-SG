Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IDimage", "[", "som_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Image", "[", 
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"som", "[", "\"\<weights\>\"", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "3"}], "]"}], "]"}], "]"}], ",", 
      RowBox[{"som", "[", 
       RowBox[{"\"\<dimensions\>\"", ",", "\"\<y\>\""}], "]"}]}], "]"}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IDslices", "[", "som_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ArrayPlot", "[", 
     RowBox[{
      RowBox[{"Partition", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"som", "[", 
         RowBox[{"\"\<dimensions\>\"", ",", "\"\<y\>\""}], "]"}]}], "]"}], 
      ",", " ", 
      RowBox[{"ColorFunction", "\[Rule]", 
       RowBox[{"ColorData", "[", "\"\<GrayTones\>\"", "]"}]}]}], "]"}], "&"}],
    "/@", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"som", "[", "\"\<weights\>\"", "]"}], "]"}]}]}]}], "Code",
