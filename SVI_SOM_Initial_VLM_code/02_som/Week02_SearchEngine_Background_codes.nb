Cell[BoxData[
 RowBox[{
  RowBox[{"rendercellWeights", "[", 
   RowBox[{"som_", ",", "colorScheme_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"allDims", ",", "color", ",", "somImg"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"allDims", " ", "=", 
      RowBox[{"Rescale", "[", 
       RowBox[{"Re", "@", 
        RowBox[{"Total", "@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"som", "[", 
           RowBox[{"\"\<kernel\>\"", ",", "\"\<weights\>\""}], "]"}], 
          "]"}]}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"merge", " ", "by", " ", 
       RowBox[{
        RowBox[{"channel", " ", "/", " ", "dimension"}], " ", "/", " ", 
        "the"}], " ", "total", " ", "of", " ", "each", " ", "cell"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"color", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "colorScheme", "]"}], "[", "#", "]"}], 
        "&"}], "/@", "allDims"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "getting", " ", "the", " ", "colors", " ", "from", " ", "the", " ", 
       "weights"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"somImg", "=", 
      RowBox[{"Image", "[", 
       RowBox[{
        RowBox[{"ArrayReshape", "[", 
         RowBox[{"color", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"som", "[", 
             RowBox[{
             "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<x\>\""}], 
             "]"}], ",", 
            RowBox[{"som", "[", 
             RowBox[{
             "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<y\>\""}], 
             "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "Medium"}], ",", 
        RowBox[{"ColorSpace", "\[Rule]", "\"\<RGB\>\""}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
