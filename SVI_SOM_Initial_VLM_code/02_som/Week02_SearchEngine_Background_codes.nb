Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "use", " ", "undocumented", " ", "functions", " ", "to", " ", "load", " ", 
    "images", " ", "for", " ", "at", " ", "least", " ", "10", " ", "times", 
    " ", "faster"}], "*)"}], 
  RowBox[{
   RowBox[{"FastImageImport", "[", "f_", "]"}], ":=", 
   RowBox[{"Switch", "[", 
    RowBox[{
     RowBox[{"ToLowerCase", "@", 
      RowBox[{"StringTake", "[", 
       RowBox[{"f", ",", 
        RowBox[{"-", "4"}]}], "]"}]}], ",", "\"\<.jpg\>\"", ",", 
     RowBox[{"First", "@", 
      RowBox[{"Image`ImportExportDump`ImageReadJPEG", "@", "f"}]}], ",", 
     "\"\<.png\>\"", ",", 
     RowBox[{"First", "@", 
      RowBox[{"Image`ImportExportDump`ImageReadPNG", "@", "f"}]}], ",", "_", 
     ",", 
     RowBox[{"Import", "@", "f"}]}], "]"}]}]}]], "Input",
 InitializationCell->True,
