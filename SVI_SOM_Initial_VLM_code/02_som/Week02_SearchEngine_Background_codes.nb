Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cellimg2render", "[", 
    RowBox[{"som_", ",", "imgfolder_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"temp", ",", "somimgs", ",", 
       RowBox[{"whiteimg", "=", 
        RowBox[{"Image", "@", 
         RowBox[{"Table", "[", 
          RowBox[{"1", ",", "$CellRenderSize", ",", "$CellRenderSize"}], 
          "]"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"somimgs", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"temp", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{"imgfolder", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"som", "[", "\"\<eventListSorted\>\"", "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"#", "\[NotEqual]", "\"\<\>\""}], "&"}]}], "]"}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "@", "temp"}], "\[Equal]", "0"}], ",", 
            "\"\<\>\"", ",", 
            RowBox[{"First", "@", 
             RowBox[{"RandomSample", "[", 
              RowBox[{"temp", ",", "1"}], "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"som", "[", 
            RowBox[{
            "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<len\>\""}],
             "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"somimgs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"ImagePad", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "\[NotEqual]", "\"\<\>\""}], ",", 
             RowBox[{"ImportCropedImage", "[", "#", "]"}], ",", "whiteimg"}], 
            "]"}], ",", "$CellPadSize", ",", "White"}], "]"}], "&"}], "/@", 
        "somimgs"}]}], ";", "\[IndentingNewLine]", "somimgs"}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
