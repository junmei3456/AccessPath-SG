Cell["\<\
save som + data with one file:

> kernel: the som weights and dimensions
> bmus: best matching unit
> indexListSorted:index of image list of objects for each bmu
> eventListSorted: images paths  of objects for each bmu
> imgvecListSorted: vectors of images for each bmu\
\>", "Text",
 CellChangeTimes->{{3.7829903934357986`*^9, 3.7829904910969057`*^9}, {
  3.782991922752879*^9, 3.7829919242557716`*^9}, {3.83836727843537*^9, 
  3.838367415782461*^9}, {3.9779631451648893`*^9, 
  3.977963145527423*^9}},ExpressionUUID->"66b8b80f-32f4-4d20-acd5-\
809de7ea50e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetSOM", "[", 
   RowBox[{"veclist_", ",", "id_", ",", "imgpathlist_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bmus", ",", "indexListSorted", ",", "imageListSorted", ",", 
      "imgvecListSorted", ",", "projindexListSorted", ",", 
      "keywordListSorted"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bmus", "=", " ", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"First", "@", "#2"}], "\[Rule]", 
          RowBox[{"First", "@", 
           RowBox[{"IDask", "[", 
            RowBox[{"id", ",", " ", 
             RowBox[{"{", "#1", "}"}]}], "]"}]}]}], "&"}], ",", " ", 
        "veclist"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"index", " ", "of", " ", "images"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"indexListSorted", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"bmus", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", "cell"}], "&"}]}], 
          "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"cell", ",", 
          RowBox[{"id", "[", 
           RowBox[{"\"\<dimensions\>\"", ",", "\"\<len\>\""}], "]"}]}], 
         "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"imageListSorted", "=", 
      RowBox[{"Extract", "[", 
       RowBox[{"imgpathlist", ",", 
        RowBox[{"Transpose", "@", 
         RowBox[{"{", "indexListSorted", "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"repeat", " ", "projindex", " ", "according", " ", "to"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"imgvecListSorted", "=", 
      RowBox[{"Extract", "[", 
       RowBox[{"veclist", ",", 
        RowBox[{"Transpose", "@", 
         RowBox[{"{", "indexListSorted", "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
