           RowBox[{"[", "1", "]"}], "]"}]}], "&"}], ",", 
        RowBox[{"som", "[", "\"\<weights\>\"", "]"}]}], "]"}], ",", "vec"}], 
     "]"}]}]}], "\n"}], "\n", 
 RowBox[{
