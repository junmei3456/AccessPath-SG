Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "show", " ", "the", " ", "image", " ", "closest", " ", "to", " ", "the", 
    " ", "bmu"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"rendersomclosestimg", "[", "som_", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "indexListSorted", ",", "showList", ",", "lastDist", ",", "bmus", ",", 
       "dist", ",", "i", ",", "j", ",", 
       RowBox[{"whiteimg", "=", 
        RowBox[{"Image", "@", 
         RowBox[{"Table", "[", 
          RowBox[{"1", ",", "$CellRenderSize", ",", "$CellRenderSize"}], 
          "]"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"indexListSorted", "=", 
       RowBox[{"som", "[", "\"\<indexListSorted\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"showList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"\"\<\>\"", ",", 
         RowBox[{"som", "[", 
          RowBox[{
          "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<len\>\""}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", 
         RowBox[{"som", "[", 
          RowBox[{
          "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<len\>\""}], 
          "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"lastDist", "=", "Infinity"}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "\[LessEqual]", 
            RowBox[{"Length", "@", 
             RowBox[{
              RowBox[{"som", "[", "\"\<eventListSorted\>\"", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"dist", "=", 
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"som", "[", 
                 RowBox[{"\"\<kernel\>\"", ",", "\"\<weights\>\""}], "]"}], 
                "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"som", "[", "\"\<imgvecListSorted\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"dist", "<", "lastDist"}], ",", 
              RowBox[{
               RowBox[{"lastDist", "=", "dist"}], ";", 
               RowBox[{
                RowBox[{"showList", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "=", 
                RowBox[{
                 RowBox[{"som", "[", "\"\<eventListSorted\>\"", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";"}]}], "]"}]}]}],
           "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"bmus", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"ImagePad", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "\[NotEqual]", "\"\<\>\""}], ",", 
             RowBox[{"ImportCropedImage", "@", "#"}], ",", "whiteimg"}], 
            "]"}], ",", "$CellPadSize", ",", "White"}], "]"}], "&"}], "/@", 
        "showList"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ImageAssemble", "[", 
       RowBox[{"Partition", "[", 
        RowBox[{"bmus", ",", 
         RowBox[{"som", "[", 
          RowBox[{
          "\"\<kernel\>\"", ",", "\"\<dimensions\>\"", ",", "\"\<x\>\""}], 
          "]"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
