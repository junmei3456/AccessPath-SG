Cell[BoxData[
 RowBox[{
  RowBox[{"IDcreate", " ", "[", 
   RowBox[{"somX_", ",", "somY_", ",", "somD_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "somCoords", ",", "somLen", ",", "somWeights", ",", "distances"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"somCoords", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", "j"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1.", ",", "somX"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1.", ",", "somY"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"somLen", "=", 
      RowBox[{"somX", " ", "*", " ", "somY"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"somWeights", "=", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{"somLen", ",", " ", "somD"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"somWeights", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Normalize", "@", "#"}], "&"}], "/@", "somWeights"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"distances", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"DistanceMatrix", "[", 
         RowBox[{"somCoords", ",", 
          RowBox[{
          "DistanceFunction", "\[Rule]", "SquaredEuclideanDistance"}]}], 
         "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<dimensions\>\"", "\[Rule]", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<x\>\"", "\[Rule]", " ", "somX"}], ",", 
          RowBox[{"\"\<y\>\"", "\[Rule]", " ", "somY"}], ",", 
          RowBox[{"\"\<dim\>\"", "\[Rule]", " ", "somD"}], ",", " ", 
          RowBox[{"\"\<len\>\"", "\[Rule]", " ", 
           RowBox[{"somX", "*", "somY"}]}]}], "|>"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<weights\>\"", "\[Rule]", " ", "somWeights"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<coordinates\>\"", "\[Rule]", "somCoords"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<distances\>\"", "\[Rule]", "distances"}]}], 
      "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.664956846177367*^9, 3.6649568572608833`*^9}, {
   3.664956946370016*^9, 3.664957104677999*^9}, {3.664957337072308*^9, 
